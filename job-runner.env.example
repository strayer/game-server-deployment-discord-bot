# Hetzner Cloud API token used by the provisioner (discord_bot/provisioner.py).
# HCLOUD_TOKEN is also accepted; TF_VAR_hcloud_token is kept for continuity.
TF_VAR_hcloud_token=foobar

# NOTE: DNS was dropped in the Terraform->API migration. There is no Cloudflare
# token, zone, or per-game subdomain any more — servers are reached by IP.
#
# The remaining TF_VAR_* variables below feed the cloud-init templates
# (discord_bot/cloud_init/<game>.tftpl); the names must match the template
# placeholders (TF_VAR_<placeholder>).

# Valheim

TF_VAR_restic_valheim_repo="s3:https://s3.example.tld/restic-valheim"
TF_VAR_restic_valheim_password=foobar
TF_VAR_restic_valheim_aws_access_key_id=foobar
TF_VAR_restic_valheim_aws_secret_access_key=foobar

TF_VAR_valheim_server_name=valheim
TF_VAR_valheim_server_world=valheim
TF_VAR_valheim_server_password=valheim
TF_VAR_valheim_discord_channel_webhook="https://discord.com/api/webhooks/foo/bar"

# Factorio

TF_VAR_restic_factorio_repo="s3:https://s3.example.tld/restic-factorio"
TF_VAR_restic_factorio_password=foobar
TF_VAR_restic_factorio_aws_access_key_id=foobar
TF_VAR_restic_factorio_aws_secret_access_key=foobar

TF_VAR_factorio_save_name=factorio
TF_VAR_factorio_discord_channel_webhook="https://discord.com/api/webhooks/foo/bar"

# Enshrouded

TF_VAR_restic_enshrouded_repo="s3:https://s3.example.tld/restic-enshrouded"
TF_VAR_restic_enshrouded_password=foobar
TF_VAR_restic_enshrouded_aws_access_key_id=foobar
TF_VAR_restic_enshrouded_aws_secret_access_key=foobar

TF_VAR_enshrouded_server_name=enshrouded
TF_VAR_enshrouded_server_password=enshrouded
TF_VAR_enshrouded_discord_channel_webhook="https://discord.com/api/webhooks/foo/bar"

# Abiotic Factor

TF_VAR_restic_abiotic_factor_repo="s3:https://s3.example.tld/restic-abiotic-factor"
TF_VAR_restic_abiotic_factor_password=foobar
TF_VAR_restic_abiotic_factor_aws_access_key_id=foobar
TF_VAR_restic_abiotic_factor_aws_secret_access_key=foobar

TF_VAR_abiotic_factor_server_name=abiotic-factor
TF_VAR_abiotic_factor_server_password=abiotic-factor
TF_VAR_abiotic_factor_world_save_name=Cascade
TF_VAR_abiotic_factor_discord_channel_webhook="https://discord.com/api/webhooks/foo/bar"

# Windrose

TF_VAR_restic_windrose_repo="s3:https://s3.example.tld/restic-windrose"
TF_VAR_restic_windrose_password=foobar
TF_VAR_restic_windrose_aws_access_key_id=foobar
TF_VAR_restic_windrose_aws_secret_access_key=foobar

TF_VAR_windrose_server_name=windrose
TF_VAR_windrose_server_password=windrose
TF_VAR_windrose_max_players=10
TF_VAR_windrose_discord_channel_webhook="https://discord.com/api/webhooks/foo/bar"
